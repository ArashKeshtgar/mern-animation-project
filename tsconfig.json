{
  "compilerOptions": {
    "target": "ES2020",
    "module": "node16",
    "lib": ["ES2020"],
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node16",
    "declaration": false,
    "sourceMap": true
  },
  "include": [
    "server.ts",
    "app.ts",
    "env.ts",
    "db.ts",
    "config/**/*.ts",
    "middleware/**/*.ts",
    "models/**/*.ts",
    "routes/**/*.ts",
    "seed/**/*.ts",
    "types/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "client", "uploads", "test"]
}
